# Example environment variables for quickeeparts

# eBay API credentials
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_AUTH_TOKEN=your_ebay_auth_token_here

# AI / Image Recognition Service
AI_SERVICE_API_KEY=your_ai_service_api_key_here
AI_SERVICE_ENDPOINT=https://api.example.com/v1/recognize

# Database
DATABASE_URL=sqlite:///parts.db

# Application
SECRET_KEY=change_me_to_a_random_secret_key
APPROVAL_REQUIRED=true
ALLOWED_PLATFORMS=ebay
